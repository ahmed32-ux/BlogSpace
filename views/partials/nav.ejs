<!-- Bootstrap CSS: Include only once in head.ejs -->
<link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
>

<style>
    /* Navbar */
    .blog-navbar {
        background: #42793e;
        padding: 14px 0;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
    }

    /* Brand */
    .blog-navbar .navbar-brand {
        color: #ffffff;
        font-size: 25px;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .blog-navbar .navbar-brand:hover {
        color: #d1fae5;
    }

    /* Navigation Links */
    .blog-navbar .nav-link {
        color: #f3f4f6;
        font-weight: 500;
        padding: 10px 15px;
        transition: color 0.2s ease;
    }

    .blog-navbar .nav-link:hover,
    .blog-navbar .nav-link.active {
        color: #d1fae5;
    }

    /* Mobile Toggle */
    .blog-navbar .navbar-toggler {
        border-color: rgba(255, 255, 255, 0.5);
    }

    .blog-navbar .navbar-toggler:focus {
        box-shadow: 0 0 0 0.15rem rgba(255, 255, 255, 0.3);
    }

    .blog-navbar .navbar-toggler-icon {
        filter: brightness(0) invert(1);
    }

    /* Dropdown Menu */
    .blog-navbar .dropdown-menu {
        background: #ffffff;
        border: none;
        border-radius: 10px;
        padding: 8px;
        min-width: 190px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    }

    /* Dropdown Items */
    .blog-navbar .dropdown-item {
        padding: 10px 14px;
        border-radius: 6px;
        transition: background 0.2s ease, color 0.2s ease;
    }

    .blog-navbar .dropdown-item:hover {
        background: #eff6ff;
        color: #1d4ed8;
    }

    /* User Dropdown Button */
    .blog-navbar .user-link {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 8px;
    }

    .blog-navbar .user-link:hover,
    .blog-navbar .user-link:focus {
        background: rgba(255, 255, 255, 0.15);
        color: #ffffff;
    }

    /* Logout Item */
    .blog-navbar .logout-link {
        color: #dc3545;
    }

    .blog-navbar .logout-link:hover {
        background: #fee2e2;
        color: #b91c1c;
    }
</style>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg blog-navbar">
    <div class="container">

        <!-- Brand -->
        <a class="navbar-brand" href="/">
            BlogSpace
        </a>

        <!-- Mobile Toggle -->
        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarSupportedContent"
            aria-controls="navbarSupportedContent"
            aria-expanded="false"
            aria-label="Toggle navigation"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar Content -->
        <div
            class="collapse navbar-collapse"
            id="navbarSupportedContent"
        >
            <ul class="navbar-nav me-auto ms-lg-4">

                <!-- Home -->
                <li class="nav-item">
                    <a class="nav-link active" href="/">
                        Home
                    </a>
                </li>

                <% if (locals.user) { %>

                    <!-- Add Blog -->
                    <li class="nav-item">
                        <a class="nav-link" href="/blog/add-new">
                            Add Blog
                        </a>
                    </li>

                    <!-- User Dropdown -->
                    <li class="nav-item dropdown">

                        <a
                            class="nav-link dropdown-toggle user-link"
                            href="#"
                            id="navbarDropdown"
                            role="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                        >
                            <span class="me-1">&#128100;</span>
                            <%= locals.user.fullName %>
                        </a>

                        <!-- Dropdown Menu -->
                        <ul
                            class="dropdown-menu dropdown-menu-end mt-2"
                            aria-labelledby="navbarDropdown"
                        >

                            <!-- Profile -->
                            <li>
                                <a
                                    class="dropdown-item"
                                    href="/user/profile"
                                >
                                    <span class="me-2">&#128100;</span>
                                    My Profile
                                </a>
                            </li>

                            <li>
                                <hr class="dropdown-divider">
                            </li>

                            <!-- Logout -->
                            <li>
                                <a
                                    class="dropdown-item logout-link"
                                    href="/users/logout"
                                >
                                    <span class="me-2">&#10162;</span>
                                    Log Out
                                </a>
                            </li>

                        </ul>
                    </li>

                <% } else { %>

                    <!-- Guest Links -->
                    <li class="nav-item">
                        <a class="nav-link" href="/users/signin">
                            LogIn
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/users/signup">
                            Create Account
                        </a>
                    </li>

                <% } %>

            </ul>
        </div>

    </div>
</nav>

<!-- Bootstrap JS: Include only once, preferably before </body> -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>